# Local Kafka host listener. Containers use kafka:29092 instead.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_RAW_TRADES_TOPIC=raw-trades
KAFKA_DLQ_TOPIC=raw-trades-dlq
KAFKA_PRODUCER_CLIENT_ID=streaming-market-producer
KAFKA_FLUSH_TIMEOUT_SECONDS=10
PRODUCER_RECONNECT_BASE_SECONDS=1
PRODUCER_RECONNECT_MAX_SECONDS=30
PRODUCER_METRICS_INTERVAL_SECONDS=10

# Public market-data endpoints; no API key is required.
BINANCE_WS_BASE_URL=wss://data-stream.binance.vision/ws
MEXC_WS_URL=wss://wbs-api.mexc.com/ws
MARKET_SYMBOLS=BTCUSDT
MEXC_TRADE_UPDATE_SPEED=100ms
MEXC_HEARTBEAT_INTERVAL_SECONDS=20

# Local-only PostgreSQL credentials. Replace them outside this laptop topology.
POSTGRES_DB=streaming
POSTGRES_USER=streaming
POSTGRES_PASSWORD=streaming-local-only
POSTGRES_DSN=postgresql://streaming:streaming-local-only@localhost:5432/streaming

# Local state. Checkpoints are operational state and must not be deleted casually.
LOCAL_DATA_DIR=data
CHECKPOINT_BASE_DIR=checkpoints

SPARK_MASTER=local[2]
SPARK_DRIVER_MEMORY=1g
SPARK_SHUFFLE_PARTITIONS=4
SPARK_STARTING_OFFSETS=earliest
SPARK_MAX_OFFSETS_PER_TRIGGER=20000
SPARK_TRIGGER_INTERVAL_SECONDS=5
LIVE_PIPELINE_FAIL_ON_DATA_LOSS=false

LIVE_TRADE_RETENTION_MINUTES=60
DASHBOARD_SYMBOL=BTCUSDT
DASHBOARD_REFRESH_SECONDS=3
DASHBOARD_STALE_AFTER_SECONDS=15
DASHBOARD_CHART_POINTS=2000

LOG_LEVEL=INFO
